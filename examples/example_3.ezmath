// example_3: full symbol and syntax tour //

# Full syntax tour

*define(write_type.multiplication = .)

## 1. Defines, variables and calc

*define(school = Nguyen Trai High School)
*define(tmp1 = 100 000 000)

<tmp1>

*(
    <width> = 5
    <height> = 3
    <area> = <width> * <height>
)

The school is <school>.
The rectangle is <width> cm wide and <height> cm tall.
Its area is: <width> . <height> = calc(<area>) cm²

let <a> = 10
var b = 20
<c> = calc(<a> + <b> * 2)

Sum: <a> + <b> = <c>

## 2. Raw print

*p(f())
*p(sin(x))

## 3. Fractions, roots, powers

*frac(2 ; 3)
*fraction(4 ; 5)
*frac(2, 3)

*root(3 ; x + 1)
*root(2 ; x)
*sqrt(16)
*cbrt(27)

*pow(x ; 2)
*power(x ; 3)
*pow(A ; *degree)

A_1
x_n

*abs(x - 2)
*absolute(x - 5)

## 4. Trigonometry and logarithms

*sin(x)
*cos(x)
*tan(x)

*log(10)
*ln(2.718)

## 5. Sums, products, limits

*sum(i = 1 ; n ; i)
*summation(i = 1 ; n ; i^2)
*prod(i = 1 ; n ; i)
*product(k = 1 ; n ; k + 1)
*lim(x -> 0 ; sin(x) / x)
*limit(n -> infinity ; 1 / n)

## 6. Constants

*pi
*infinity

## 7. Automatic ASCII symbols

a => b
a <=> b
a <== b
a ==> b
x -> 0
x <- 1
a <-> b
f |-> y
a <= b
a >= b
a << b
a >> b
a != b
a !== b
a === b
p && q
p || q
h |- c
c -| h
a +- b
a -+ b
a ~= b
a ~=~ b
wait ...

a == b

