# Maintainer: duo8097 <Imanoob8097@gmail.com>
pkgname=easy-math-lang-git
# Placeholder only: pkgver() below overrides it at build time (git
# describe in a VCS checkout, the pyproject.toml version for a source
# tarball). Keep it in sync with pyproject.toml so a raw copy of this
# PKGBUILD (e.g. an AUR helper reading it without building) still shows
# a sensible version; tests/test_installer_script.py checks the match.
pkgver=6.0.0
pkgrel=1
pkgdesc='Plain-text math documents to PDF, images, HTML and Typst (compiler, language server and desktop editor)'
arch=('x86_64')
url='https://github.com/duo8097/easy-math-lang'
license=('MIT')
depends=()
makedepends=('git' 'uv' 'fcitx5-qt')
optdepends=('libgl: hardware-accelerated rendering in the desktop editor'
            'fontconfig: font discovery in the desktop editor'
            'fcitx5-qt: fcitx5 input method (e.g. Vietnamese Telex) in the editor — bundled only when the system Qt matches PySide6')
provides=('easy-math-lang')
conflicts=('easy-math-lang')
# Do not strip: PyInstaller onedir executables carry the payload archive
# (and the bootloader resolves it) such that `strip` can corrupt the build;
# the build scripts already avoid stripping finished binaries.
options=('!strip')
source=('easy-math-lang::git+https://github.com/duo8097/easy-math-lang.git')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/easy-math-lang"
  # A VCS checkout describes the commit; a plain source tarball (what the
  # CI build packs, see installer/build_arch.sh) falls back to the
  # version declared in pyproject.toml.
  local v
  if v=$(git describe --long --tags 2>/dev/null); then
    echo "${v#v}" | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
  else
    sed -n 's/^version = "\(.*\)"$/\1/p' pyproject.toml
  fi
}

build() {
  cd "$srcdir/easy-math-lang"

  # `uv sync` installs the project editable, so the shared builder can
  # `from compiler/editor/lsp import main` (same as CI).
  uv sync --frozen

  # The PyInstaller flags live in one place (see scripts/build_binaries.py).
  uv run --frozen python scripts/build_binaries.py

  chmod +x dist/easy-math-lang/easy-math-lang dist/easy-math-lang/easy-math-lsp \
    dist/easy-math-lang/easy-math-editor
  test -x dist/easy-math-lang/easy-math-lang
}

package() {
  cd "$srcdir/easy-math-lang"

  # Self-contained PyInstaller bundle: no Python runtime needed.
  # The shared onedir bundle carries the CLI, the LSP and the editor exe
  # plus one _internal/ with all heavy libraries (and the vendored
  # Typst packages for offline *draw). Copy the whole bundle like the
  # .deb/.rpm path does — installing only the three executables would
  # ship a broken app.
  rm -rf "$pkgdir/usr/lib/easy-math-lang"
  mkdir -p "$pkgdir/usr/lib/easy-math-lang"
  cp -a dist/easy-math-lang/. "$pkgdir/usr/lib/easy-math-lang/"
  chmod +x "$pkgdir/usr/lib/easy-math-lang/easy-math-lang" \
    "$pkgdir/usr/lib/easy-math-lang/easy-math-lsp" \
    "$pkgdir/usr/lib/easy-math-lang/easy-math-editor"

  mkdir -p "$pkgdir/usr/bin"
  ln -s /usr/lib/easy-math-lang/easy-math-lang "$pkgdir/usr/bin/easy-math-lang"
  ln -s easy-math-lang "$pkgdir/usr/bin/ezmath"
  ln -s /usr/lib/easy-math-lang/easy-math-lsp "$pkgdir/usr/bin/easy-math-lsp"
  ln -s /usr/lib/easy-math-lang/easy-math-editor "$pkgdir/usr/bin/easy-math-editor"

  install -Dm644 installer/easy-math-editor.desktop \
    "$pkgdir/usr/share/applications/easy-math-editor.desktop"
  # Hicolor app icons backing the desktop entry's Icon=ezmath (one PNG
  # per size; the file names match the hicolor <size>x<size> folders so
  # menus, docks and file managers resolve the theme icon directly).
  for size in 16 32 48 64 128 256; do
    install -Dm644 "icons/ezmath-${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/ezmath.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # MIT license text plus third-party notices (CeTZ is
  # LGPL-3.0-or-later, bundled for offline *draw).
  install -Dm644 THIRD_PARTY_LICENSES "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_LICENSES"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
